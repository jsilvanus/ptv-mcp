# Copy to .env for local development. Never commit the real .env file.

NODE_ENV=development
HOST=0.0.0.0
PORT=5996
LOG_LEVEL=info

# Postgres connection used by the data layer (Phase 1+).
DATABASE_URL=postgres://ptv_mcp:ptv_mcp_dev@localhost:5456/ptv_mcp_dev

# Envelope-encryption master key for this environment (Phase 1+, used from Phase 3).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Placeholder only — real deployments must supply a securely generated,
# securely stored value (KMS/Vault-backed where available).
MASTER_ENCRYPTION_KEY=

# JWT access-token signing secret (Phase 3+). Deliberately separate from
# MASTER_ENCRYPTION_KEY — different purpose, different rotation schedule.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# PTV v11's per-user OAuth consent flow (docs/ptv-v11-notes.md). Registering
# a client with palveluhallinta.suomi.fi is an external, organization-level
# prerequisite — leave empty until one exists; the connect-PTV routes work
# but won't produce a usable authorization link without these.
PTV_V11_OAUTH_CLIENT_ID=
PTV_V11_OAUTH_CLIENT_SECRET=
PTV_V11_OAUTH_REDIRECT_URI=

# Public base URL used for MCP OAuth discovery and redirects
MCP_PUBLIC_URL=http://localhost:5996
