# Copy to .env for local development. Never commit the real .env file.

NODE_ENV=development
# Loopback keeps the API behind your reverse proxy; use 0.0.0.0 only inside a container.
HOST=127.0.0.1
PORT=5999
LOG_LEVEL=info

# Postgres connection used by the data layer (Phase 1+).
DATABASE_URL=postgres://ptv_mcp:ptv_mcp_dev@localhost:5456/ptv_mcp_dev

# Production refuses to start when DATABASE_URL connects as a superuser or BYPASSRLS role
# (row-level security would be off). Set true only to start anyway; elsewhere it is a warning.
ALLOW_PRIVILEGED_DB_ROLE=

# Envelope-encryption master key for this environment (Phase 1+, used from Phase 3).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Placeholder only — real deployments must supply a securely generated,
# securely stored value (KMS/Vault-backed where available).
MASTER_ENCRYPTION_KEY=

# JWT access-token signing secret (Phase 3+). Deliberately separate from
# MASTER_ENCRYPTION_KEY — different purpose, different rotation schedule.
# Must be base64 that decodes to at least 32 bytes; shorter values are refused at startup.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# PTV v11's per-user OAuth consent flow (docs/ptv-v11-notes.md). Registering
# a client with palveluhallinta.suomi.fi is an external, organization-level
# prerequisite — leave empty until one exists; the connect-PTV routes work
# but won't produce a usable authorization link without these.
PTV_V11_OAUTH_CLIENT_ID=
PTV_V11_OAUTH_CLIENT_SECRET=
PTV_V11_OAUTH_REDIRECT_URI=

# Public base URL used for MCP OAuth discovery and redirects
MCP_PUBLIC_URL=http://localhost:5999

# Whether POST /tenants creates tenants. Defaults to true. Recommend false in production:
# the route then answers 403, and an operator creates tenants with
#   npm run tenant:create -- --name <name> --slug <slug> --admin-email <email>
# (in the container: node dist/tenants/createTenant.js --name ... ; the account must already exist)
# ALLOW_TENANT_CREATION=true

# Set true once a real mail provider is configured: sign-in and adding members then require a verified email
REQUIRE_VERIFIED_EMAIL=

# Single sign-on through an OpenID Connect IdP (e.g. authentik); see README
# "Single sign-on". Leave OIDC_ISSUER empty to turn it off (no SSO button,
# no /oidc routes). Redirect URI to register at the IdP:
# <MCP_PUBLIC_URL>/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# OIDC_BUTTON_LABEL=Sign in with single sign-on
# OIDC_CREATE_USERS=false
# OIDC_TRUST_EMAIL=false
# Group sync: groups in the IdP's groups claim grant tenant roles at sign-in
# (README, "Group sync"). Groups are <prefix><tenant-slug>[/<role>].
# OIDC_GROUP_SYNC=false
# OIDC_GROUPS_CLAIM=groups
# OIDC_GROUP_PREFIX=ptv/
# Sign-out also ends the IdP session when the IdP advertises an end_session
# endpoint. The IdP must have this URL registered as a post-logout redirect.
# Default: <MCP public URL>/login
# OIDC_POST_LOGOUT_REDIRECT_URI=
# AUTH_MODE=both: password and SSO (default with OIDC). AUTH_MODE=oidc: SSO only,
# with password sign-in kept for OIDC_BREAK_GLASS_EMAILS (comma-separated). See README.
# AUTH_MODE=
# OIDC_BREAK_GLASS_EMAILS=
